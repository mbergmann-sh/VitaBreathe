<?xml version="1.0" encoding="UTF-8"?>
<!-- ERZEUGT von qmake aus package.xml.in – Änderungen bitte dort vornehmen -->
<Package>
    <DisplayName>ViviaBreathe</DisplayName>
    <Description>Guided breathing exercises with diary, reminders, alarm clock and sleep function</Description>
    <Version>@VP_VERSION@</Version>
    <ReleaseDate>@VP_RELEASE_DATE@</ReleaseDate>
    <Default>true</Default>
    <ForcedInstallation>true</ForcedInstallation>
    <SortingPriority>100</SortingPriority>
    <Licenses>
        <License name="License and disclaimer" file="license.txt"/>
    </Licenses>
    <Script>installscript.qs</Script>
</Package>
